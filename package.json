{
  "name": "payment-matcher",
  "version": "1.0.0",
  "description": "ローカル完結型の経理向け入金消込デスクトップアプリ",
  "main": "dist/electron/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "build": "tsc",
    "dist": "npm run build && electron-builder",
    "dev": "tsc && electron ."
  },
  "keywords": [
    "electron",
    "accounting",
    "payment-matching"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "csv-parser": "^3.0.0"
  },
  "build": {
    "appId": "com.payment-matcher.app",
    "productName": "入金消込アプリ",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "frontend/**/*",
      "data/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
